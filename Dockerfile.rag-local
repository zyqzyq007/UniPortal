# ==============================================================
# RAG local-models 构建分支 (GPU: BGE-M3 + reranker)
#
# 为什么需要这个文件：
#   RAG 上游的 scripts/sync_locked_deps.sh 是为 API-only 镜像设计的严格
#   hash 校验安装器，profile 白名单只有 dev / api-only，并在第 129-133 行
#   主动拒绝 torch / transformers / flagembedding 等依赖。因此
#   INSTALL_EXTRAS=local-models 走那条路径必然报
#   "unsupported profile: local-models"。
#
#   本文件绕开该脚本，直接用 uv sync --extra local-models 安装 torch 栈
#   （与 RAG 项目 deploy.sh:131,149 裸机安装方式一致；uv.lock 已锁定全套
#   依赖，索引源为阿里云镜像，国内可达）。
#
#   仅 UniPortal 侧新增此文件，RAG 项目源码零修改。
#
# 用法（docker-compose.3090.yml 中）：
#   rag:
#     build:
#       context: ../RAG
#       dockerfile: ../UniPortal/Dockerfile.rag-local
# ==============================================================

FROM python:3.13-slim AS app

# uv 版本与 RAG/Dockerfile.backend 固定一致，避免 export/hash 语义漂移
COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv

ARG UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
# torch + nvidia-cu13 依赖合计 ~2GB，给足超时
ARG UV_SYNC_TIMEOUT_SECONDS=1800

ENV UV_PROJECT_ENVIRONMENT=/app/venv \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEPLOYMENT_ENV=production

WORKDIR /app

# 先只 COPY 依赖清单，利用层缓存（torch 栈很大，源码改动不应触发重装）
COPY pyproject.toml uv.lock ./
# --no-install-project: 只装依赖不装本工程；uv.lock 已锁定 local-models 闭包
RUN uv sync --frozen --no-install-project --extra local-models

# 再 COPY 全部源码并安装本工程自身
COPY . .
RUN uv sync --frozen --extra local-models

# 运行时默认值（API-only 默认）；实际由 docker-compose 环境变量覆盖为本地模型。
# 保留与 Dockerfile.backend 一致，便于切换。
ENV EMBEDDING_PROVIDER=api \
    RERANKER_ENABLED=false \
    EMBEDDING_MODEL=text-embedding-v3 \
    EMBEDDING_DIMENSION=512 \
    MILVUS_SPARSE_INDEX=false \
    OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 \
    MILVUS_DB_URI=/app/data/milvus_data.db

EXPOSE 8000

# 本地模型首次加载较慢（BGE-M3 + reranker 约 2GB 权重），拉长 start-period
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/admin/health',timeout=3).status==200 else 1)" || exit 1

# 与 Dockerfile.backend 一致：启动前加载 UniPortal 写入的 RAG 覆盖配置
CMD ["sh", "-c", "if [ -f /app/data/rag_override.env ]; then set -a && . /app/data/rag_override.env && set +a; fi && exec uv run --frozen --no-sync uvicorn api.main:app --host 0.0.0.0 --port 8000"]
