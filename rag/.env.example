# =============================================================================
# Deployment mode and HTTP security boundary.
# Development is loopback-only. Normal production requires a non-empty
# ADMIN_API_KEY and at least one non-loopback HTTP(S) origin. The dedicated WSL
# localhost guide instead sets LOCAL_ONLY_DEPLOYMENT=true and requires every
# origin to be literal loopback; do not use that flag for LAN/public exposure.
# =============================================================================
DEPLOYMENT_ENV=development
LOCAL_ONLY_DEPLOYMENT=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_API_KEY=

# =============================================================================
# Domain profile — which knowledge domain this deployment serves.
# The profile (data/profiles/<name>.yaml) drives prompts, output structure,
# routing keywords and PII patterns. Default is "general" (domain-agnostic).
# Set DOMAIN_PROFILE=aviation_phm to load the bundled optional aerospace
# example profile. New domains only require a new YAML under data/profiles/.
# =============================================================================
DOMAIN_PROFILE=general
# Optional immutable profile directory override, used by production layouts.
# DOMAIN_PROFILES_DIR=/opt/rag-platform/data/profiles

# =============================================================================
# LLM - any OpenAI-compatible endpoint
# =============================================================================
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# =============================================================================
# Embedding provider selection (api-only-deploy).
# - local: HuggingFaceEmbeddings (needs `uv sync --extra local-models`; torch).
# - api:   DashScope text-embedding-v3 (zero torch; needs DASHSCOPE_* below).
# - auto:  local when torch is importable, else api. Default.
# The API-only Docker image sets EMBEDDING_PROVIDER=api; a bare-metal local
# deploy leaves this at local (torch installed) — set it explicitly to match.
# =============================================================================
EMBEDDING_PROVIDER=local

# =============================================================================
# Embedding (local provider) - local path preferred, else model ID loads from
# Hugging Face. EMBEDDING_DIMENSION must match the selected model. Rebuild the
# Milvus collection after changing model or dimension.
#
# Default is BGE-M3 (docs/specs/retrieval-backend-modernization): dense (1024d) +
# sparse (lexical_weights) + ColBERT from a single forward pass, 8192 token
# context. Set EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5 + DIMENSION=512 to revert
# (also set MILVUS_SPARSE_INDEX=false to use the self-implemented BM25 sparse leg).
# =============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=models/local_models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=8

# BGE-M3 loading options (ignored when EMBEDDING_MODEL is not BGE-M3).
# BGEM3FlagModel backs dense+sparse/ColBERT; AutoModel is loaded only for late chunking.
# Native sparse and ColBERT require trained sparse_linear.pt + colbert_linear.pt;
# scripts/download_bge_m3.py validates both and missing heads degrade safely to dense/BM25.
# F-06: FlashAttention2 cuts the 8K attention peak; without it, max_length drops
# to 2048 and late-chunk throughput falls. flash-attn wheel must be prepacked for
# air-gapped deploys (see scripts/download_bge_m3.py reminder).
BGE_M3_USE_FP16=true
BGE_M3_MAX_LENGTH=8192
BGE_M3_DEVICE=auto
BGE_M3_FLASH_ATTENTION=true

# Milvus native sparse vector (F-02). When true, the sparse leg uses Milvus
# sparse_search (BGE-M3 lexical_weights) instead of the self-implemented BM25.
# F-01: filter goes through search(filter=), not hybrid_search's top-level filter.
# Set false to revert to BM25; BGE-M3 dense retrieval may remain enabled.
MILVUS_SPARSE_INDEX=true

# Late chunking (§3.5). Embed the full parent section then mean-pool per chunk
# span so each chunk carries global context. F-05: dense-only; sparse is per-chunk.
# F-06: ingest-time forward serialised by INGEST_EMBEDDING_CONCURRENCY semaphore.
LATE_CHUNKING_ENABLED=true
LATE_CHUNKING_MIN_TOKENS=256
INGEST_EMBEDDING_CONCURRENCY=1

# Algorithm constants (F4 — eval-flywheel-tunable). Defaults match the pre-F4
# hardcoded values; override after calibration via scripts/calibrate_retrieval.py.
# RRF_K: reciprocal rank fusion constant (lower = more weight to top ranks).
# MMR_LAMBDA: 1.0 = pure relevance, 0.0 = pure diversity.
# DENSE_WEIGHT / SPARSE_WEIGHT: RRF leg weights (should sum to ~1.0).
RRF_K=60
MMR_LAMBDA=0.7
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# =============================================================================
# Embedding (api provider) - Aliyun DashScope text-embedding-v3.
# Used when EMBEDDING_PROVIDER=api (or auto without torch). DASHSCOPE_API_KEY is
# a runtime secret — NEVER commit it. EMBEDDING_DIMENSION must be one of the
# v3 valid sizes {1024,768,512,256,128,64}; the default 1024 matches the local
# BGE-M3 schema so the same Milvus collection is reusable. WARNING: document text
# is sent to DashScope for embedding — PII compliance is the operator's
# responsibility (the input guardrail only covers the chat path, not ingestion).
# =============================================================================
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Cross-encoder reranker. Default ON — a Chinese-capable cross-encoder is part
# of the shipped retrieval stack, not an opt-in extra. Set RERANKER_ENABLED=false
# to disable. DEVICE=auto picks cuda when the installed torch wheel has a kernel
# for this GPU (else cpu). deploy.sh prewarms the model into the project-local
# path below so offline bundles do not depend on ~/.cache.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=models/local_models/reranker/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_WARMUP=false
RERANKER_CANDIDATE_TOP_K=10
RERANKER_TOP_K=5
# bge-reranker-v2-m3 is ~2.1GB FP32 (568M params); batch 4 bounds peak CPU RSS.
RERANKER_BATCH_SIZE=4

# Shared adaptive/corrective retrieval workflow. Promoted after isolated AB/BA
# benchmarks; set false to restore the legacy list-only retrieval path.
RETRIEVAL_WORKFLOW_ENABLED=true
# Stage-1 experiments remain off because the controlled quality gate was not met.
RETRIEVAL_CANDIDATE_FUNNEL_ENABLED=false
CONTEXTUAL_INDEX_ENABLED=false
# Optional frontier channels remain off until a real-model/domain benchmark is reviewed.
COLBERT_RERANK_ENABLED=false
RAPTOR_ENABLED=false
RAPTOR_DB_PATH=data/raptor.db
GRAPH_PPR_ENABLED=false
COLPALI_ENABLED=false
COLPALI_MODEL_PATH=models/local_models/colpali
VISUAL_INDEX_PATH=data/visual_index.db
# In-memory cache identity; paired experiments allocate a unique namespace per process.
RETRIEVAL_CACHE_NAMESPACE=default

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-platform
# OTLP/HTTP trace endpoint, for example http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=1.0
OTEL_CONSOLE_EXPORTER=false

# Storage
MILVUS_DB_URI=./milvus_data.db
COLLECTION_NAME=rag_knowledge_base

# Document ingestion
# Maximum accepted upload body (50 MiB). Oversized requests return HTTP 413.
MAX_UPLOAD_BYTES=52428800
# PDF-specific parsing/OCR settings.
# Text-layer PDFs are parsed with pypdfium2 and pypdf. Table extraction is a
# conservative text-layout heuristic; scanned/image-only pages require OCR.
PDF_EXTRACT_TABLES=true
PDF_OCR_ENABLED=false
PDF_OCR_ENGINE=paddleocr
PDF_OCR_LANG=ch
PDF_OCR_DPI=220
PDF_OCR_MIN_TEXT_CHARS=20
PDF_ASSET_DIR=data/document_assets
# CPU compatibility default. Set to 1 only after validating PaddleOCR CPU
# inference on the target host.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0

# Optional: public URL prefix when FastAPI is behind a stripping reverse proxy.
# APP_ROOT_PATH=/rag

# --- Evaluation flywheel ---------------------------------------------------
# Fraction of production chat requests captured into the inference store for
# offline eval / feedback loop. 0.1 = 10%. Degraded / low-confidence / forced
# responses are always captured regardless of this rate (importance sampling).
EVAL_SAMPLE_RATE=0.1
# Floor capture rate so the flywheel never starves even when SAMPLE_RATE=0.
EVAL_FLOOR_RATE=0.05
