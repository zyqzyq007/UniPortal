# Copy to api-only.env, set an externally reachable HTTPS origin, and keep secrets
# in deploy/secrets/. This file contains no credentials.
ALLOWED_ORIGINS=https://rag.example.com
DOMAIN_PROFILE=general
APP_ROOT_PATH=

OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=512
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
RERANKER_ENABLED=false
MILVUS_SPARSE_INDEX=false

MILVUS_DB_URI=/app/data/milvus_data.db
PDF_ASSET_DIR=/app/data/document_assets
RAPTOR_DB_PATH=/app/data/raptor.db
VISUAL_INDEX_PATH=/app/data/visual_index.db
