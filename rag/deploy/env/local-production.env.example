# Bare-metal production values. Store this as /etc/rag-platform/rag.env with
# owner root:root and mode 0600, then add real secrets locally. systemd reads it
# before dropping privileges to the service account.
DEPLOYMENT_ENV=production
ALLOWED_ORIGINS=https://rag.example.com
ADMIN_API_KEY=
DOMAIN_PROFILE=general
DOMAIN_PROFILES_DIR=/opt/rag-platform/data/profiles

OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:14b

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/opt/rag-platform/models/local_models/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=/opt/rag-platform/models/local_models/reranker/bge-reranker-v2-m3

MILVUS_DB_URI=/opt/rag-platform/data/milvus_data.db
PDF_ASSET_DIR=/opt/rag-platform/data/document_assets
RAPTOR_DB_PATH=/opt/rag-platform/data/raptor.db
VISUAL_INDEX_PATH=/opt/rag-platform/data/visual_index.db
