# WSL local production template. deploy_wsl.sh replaces only @...@ placeholders.
# Managed-By: rag-platform-wsl
DEPLOYMENT_ENV=production
LOCAL_ONLY_DEPLOYMENT=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_API_KEY=@ADMIN_API_KEY@

DOMAIN_PROFILE=general
DOMAIN_PROFILES_DIR=@DOMAIN_PROFILES_DIR@

OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=@LOCAL_MODELS_DIR@/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
BGE_M3_DEVICE=auto
BGE_M3_USE_FP16=true

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=@LOCAL_MODELS_DIR@/reranker/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_WARMUP=false

MILVUS_DB_URI=@DATA_DIR@/milvus_data.db
SESSIONS_DB=@DATA_DIR@/sessions.db
EMBEDDING_REGISTRY_DB=@DATA_DIR@/embedding_registry.db
GRAPH_STORE_DB_PATH=@DATA_DIR@/graph_store.db
GRAPH_STORE_BACKUP_PATH=@DATA_DIR@/graph_store_v1_backup.db
PDF_ASSET_DIR=@DATA_DIR@/document_assets
RAPTOR_DB_PATH=@DATA_DIR@/raptor.db
VISUAL_INDEX_PATH=@DATA_DIR@/visual_index.db

RETRIEVAL_WORKFLOW_ENABLED=true
RETRIEVAL_CANDIDATE_FUNNEL_ENABLED=false
CONTEXTUAL_INDEX_ENABLED=false
COLBERT_RERANK_ENABLED=false
RAPTOR_ENABLED=false
GRAPH_PPR_ENABLED=false
COLPALI_ENABLED=false
ENABLE_EXTERNAL_API_TOOL=false
OTEL_ENABLED=false
